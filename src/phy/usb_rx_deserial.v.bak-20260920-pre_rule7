//============================================================================
// usb_rx_deserial.v — RX 反序列化 / 字节恢复 (定稿版, clk12m 域位流水线)
// RX Deserializer (byte recovery) — final: clk12m bit pipeline
//
// usb_dpll_phy 的子模块 (PHY 最末端, 位→字节恢复; 2026-09-20 由 SIE 改挂 PHY):
//   把 CDR+clk_mux 恢复的位时钟 clk12m + NRZI 电平 rx_bit,
//   变成 SIE 事务逻辑能直接消费的对齐字节流 + 包边界信号。
//
// ★ 本文件按 doc/design_rpt/rx_deserial_design.md 定稿重写, 并应用:
//   - 位流水线 (NRZI/SYNC/解填充/字节对齐) 直接跑 clk12m(1×) 域, 每 bit 一拍;
//   - NRZI 解码 = rx_bit 打 2 拍, 相邻两拍同或 (无跳变→1): 全寄存、不依赖实时
//     rx_bit, 解码栅格整体比"单拍比较"晚 ~1 clk12m (给 EOP 门控留出余量);
//   - EOP/SE0 定界留在 ref_clk(4×) 域, Fig.7 5 态 FSM (2 段式);
//   - EOP 假 7 连 1 修复: eop_state∈{se0_3,dead}=EOP 已确认, 用 ref_clk 打一拍
//     得 eop_conf_r; 该信号 ①清 ones_cnt ②掩掉 seven_ones ③冻结移位, 使
//     "包尾连续 1 + 真 EOP" 的 SE0 段不被当成数据 1 累计到 7 (合规包不再误报);
//   - 收包帧状态机 4 态 2 段式 (时序只搬 state, 组合算次态), 全部 if/else 补全;
//   - rx_error 电平: 物理检错置起, ERROR 保持, 帧机回 USB_IDLE 即清;
//   - shift_reg 7 位 [6:0], 字节 {d_bit, shift_reg[6:0]} 第 8 位到齐拼出。
//
// 编码规范: code_rtl.md — 常量大写其余小写 / 单变量单 always+注释 / 拆子模块 /
//   if else 补全且条件完整 / 状态机一律两段式。
// 参考: doc/design_rpt/rx_deserial_design.md (定稿)
//============================================================================

`timescale 1ns/1ps

module usb_rx_deserial (
    input  wire       clk12m,           // 位流水线主时钟 12MHz (接收时 = dclk 经 usb_clk_mux)
    input  wire       ref_clk,          // 48MHz 参考时钟 (EOP/SE0 定界域, 4×)
    input  wire       ref_rstn,         // 异步复位 低有效 / async reset active-low
    input  wire       rx_bit,           // CDR 恢复的 NRZI 电平 (0=K,1=J), 领先 dclk 1 ref_clk
    input  wire       rxdp,             // USB D+ 单端 (SE0/EOP 检测, ref_clk 域采样)
    input  wire       rxdn,             // USB D- 单端 (SE0/EOP 检测, ref_clk 域采样)
    input  wire       tx_active,        // 设备正在发送 (自收发门控) / TX gating
    input  wire       rx_abort,         // SIE 溢出中止 (回 USB_IDLE, 不置 rx_error)
    output reg  [7:0] rx_data,          // 恢复的接收字节 (LSb 对齐, 维持满 667ns 字节周期)
    output reg        rx_valid,         // 每字节一拍脉冲 = 字节有效标记 (UTMI RXValid)
    output wire       rx_active,        // 帧中: (st_state==USB_DATA)||(st_state==USB_ERROR) 组合解码
    output reg        rx_error,         // 接收错误电平 (位填充违规 / EOP 错), 帧机回 idle 即清
    output wire [1:0] line_state        // 单端电平 {rxdp,rxdn} (透传)
);

    // ---- 常量 ----
    // 收包帧状态机 (clk12m 域)
    localparam USB_IDLE      = 2'd0;   // 空闲 (搜索 SYNC 前的 0)
    localparam USB_SYNC_SEEK = 2'd1;   // 数 0 (SYNC 尾巴, 找 ≥SYNC_MIN_ZERO 个 0 + 1)
    localparam USB_DATA      = 2'd2;   // 数据接收 (PID 起; rx_active=1 且吐字节)
    localparam USB_ERROR     = 2'd3;   // 错误保持 (rx_active=1 但不吐字节, 等总线回 idle)
    localparam SYNC_MIN_ZERO = 4;      // SYNC 尾巴最少 0 个数 (容忍 CDR 吃 1~2 个 0)
    localparam STUFF_MAX_ONE = 6;      // 位填充上限: 连续 6 个 1 后插 0

    // EOP FSM (ref_clk 域, Fig.7)
    localparam ST_EOP_IDLE   = 3'd0;   // 空闲 (待 SE0)
    localparam ST_EOP_SE0_1  = 3'd1;   // SE0 第 1 拍
    localparam ST_EOP_SE0_2  = 3'd2;   // SE0 第 2 拍
    localparam ST_EOP_SE0_3  = 3'd3;   // SE0 第 3 拍 (≈62.5ns, 达判决点 = EOP 确认)
    localparam ST_EOP_DEAD   = 3'd4;   // SE0 后非 J 异常收尾 (只待一拍, j 补判 eop)
    localparam EOP_WIDEN_MAX = 4'd8;   // eop/eop_err 展宽 ≥1 clk12m 周期 (plan B)

    //========================================================================
    // clk12m 域 — 位流水线
    //========================================================================

    // ---- line_state: {rxdp,rxdn} 透传 ----
    assign line_state = {rxdp, rxdn};

    // ---- NRZI 解码: 电平不变 → 数据 1; 电平跳变 → 数据 0 ----
    // rx_bit 打 2 拍 (rx_bit → rx_d1 → rx_d2), 相邻两拍同或出解码位 (全寄存,
    // 不组合依赖实时 rx_bit)。复位/自发送期对齐到 idle J (两拍都=1 → d_bit=1)。
    reg rx_d1;                            // rx_bit 打第 1 拍
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            rx_d1 <= 1'b1;                // idle J
        else if (tx_active)
            rx_d1 <= 1'b1;                // 自发送期对齐到 idle J
        else
            rx_d1 <= rx_bit;              // 采样 CDR 电平
    end

    reg rx_d2;                            // rx_bit 打第 2 拍
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            rx_d2 <= 1'b1;                // idle J
        else if (tx_active)
            rx_d2 <= 1'b1;                // 自发送期对齐到 idle J
        else
            rx_d2 <= rx_d1;               // 相邻上一拍
    end

    wire d_bit = (rx_d1 == rx_d2) ? 1'b1 : 1'b0;   // 无跳变→1 / decoded bit

    // ---- 收包帧状态 (组合解码 rx_active) ----
    wire in_frame = (st_state == USB_DATA) || (st_state == USB_ERROR);   // 帧中
    assign rx_active = in_frame;               // 帧中有效信号 (UTMI RXActive)

    // ---- 帧状态机寄存器 (2 段式·段1: 时序只搬 state) ----
    reg [1:0] st_state;                        // 收包帧状态 (2 段式·寄存器段)
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            st_state <= USB_IDLE;              // 复位回空闲
        else
            st_state <= st_nxt;                // 唯一状态更新 (次态来自组合段)
    end

    // ---- 帧状态机次态组合 (2 段式·段2: 当前态+输入→次态) ----
    // 进位优先级: eop_sync(正常关包) > eop_err_sync/7连1(错误) ; ERROR 态释放 = eop/7连1。
    // eop_conf_r 期间 7 连 1 被掩 (SE0 不是数据), 故不会因包尾 SE0 误进 ERROR。
    reg [1:0] st_nxt;                          // 帧状态机次态 (组合)
    always @* begin
        st_nxt = st_state;                     // 默认保持现态
        if (tx_active || rx_abort)
            st_nxt = USB_IDLE;                 // 自发送/中止 → 回空闲
        else begin
            case (st_state)
                USB_IDLE: begin
                    if (!d_bit)
                        st_nxt = USB_SYNC_SEEK;    // 首个 0 = 包开始候选
                    else
                        st_nxt = USB_IDLE;         // 无 0 保持空闲 (else 补全)
                end
                USB_SYNC_SEEK: begin
                    if (!d_bit && (zero_cnt == 3'd7))
                        st_nxt = USB_IDLE;         // 0 过多 (第 8 个 0) 非法
                    else if (d_bit && (zero_cnt >= SYNC_MIN_ZERO))
                        st_nxt = USB_DATA;         // SYNC 命中 (≥4 个 0 + 1)
                    else if (d_bit)
                        st_nxt = USB_IDLE;         // 假触发 (0 太少)
                    else
                        st_nxt = USB_SYNC_SEEK;    // 又一个 0, 继续 SEEK
                end
                USB_DATA: begin
                    if (eop_sync)
                        st_nxt = USB_IDLE;         // 正常关包 (SE0→J)
                    else if (eop_err_sync)
                        st_nxt = USB_ERROR;        // EOP 错 (SE0 后非 J)
                    else if (seven_ones_data)
                        st_nxt = USB_ERROR;        // 位填充违规 7 连 1 → 错误保持
                    else
                        st_nxt = USB_DATA;         // 保持收数据 (else 补全)
                end
                USB_ERROR: begin
                    if (eop_sync)
                        st_nxt = USB_IDLE;         // 坏帧仍以 SE0→J 帧尾结束 → 释放
                    else if (seven_ones_err)
                        st_nxt = USB_IDLE;         // 静默回 J, 7 连 1 再现 → 释放 (idle 探针)
                    else
                        st_nxt = USB_ERROR;        // 保持错误 (else 补全)
                end
                default:
                    st_nxt = USB_IDLE;             // 兜底 (case 补全)
            endcase
        end
    end

    // ---- zero_cnt: SYNC 连续 0 计数 (窗口仅 USB_SYNC_SEEK) ----
    reg [2:0] zero_cnt;                          // SYNC 连续 0 计数
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            zero_cnt <= 3'd0;
        else if (tx_active || rx_abort)
            zero_cnt <= 3'd0;
        else begin
            case (st_state)
                USB_IDLE: begin
                    if (!d_bit)
                        zero_cnt <= 3'd1;        // 首个 0 起数
                    else
                        zero_cnt <= 3'd0;        // else 补全
                end
                USB_SYNC_SEEK: begin
                    if (!d_bit) begin
                        if (zero_cnt == 3'd7)
                            zero_cnt <= 3'd0;    // 8 个 0 已非法, 归零重计
                        else
                            zero_cnt <= zero_cnt + 3'd1;   // 再数一个 0
                    end else begin
                        zero_cnt <= 3'd0;        // 命中/假触发 → 清 0
                    end
                end
                default:
                    zero_cnt <= 3'd0;            // DATA/ERROR 保持 0
            endcase
        end
    end

    // ---- ones_cnt: 解填充连续 1 计数 ----
    // 窗口 = rx_active (DATA/ERROR, 帧中), 帧外 (IDLE/SEEK) 保持 0;
    // 计数从 PID 起算, 进 DATA 时恒 0 —— SYNC 尾 1 不计入 (设计报告 §2.4):
    // SYNC 之后必是 PID, PID 是 code + ~code 结构, 结构上最多 4 连 1,
    // 与 SYNC 尾 1 合起来 5 < 6, 故 SYNC/PID 段不可能出现填充位。
    // bit=1 自加(封顶 6), bit=0 清零;
    // 数满 6 后下一个 bit 是 stuffed 0 (丢弃清零) 或 7 连 1 违规;
    // eop_conf_r (EOP SE0 已确认) 期间强制恒 0: 包尾 SE0 被解成"1"时不再累计
    // → 合规包"尾连续 1 + EOP"不再误判成第 7 个 1。
    reg [2:0] ones_cnt;                          // 解填充连续 1 计数
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            ones_cnt <= 3'd0;
        else if (tx_active || rx_abort)
            ones_cnt <= 3'd0;
        else if (!rx_active)
            ones_cnt <= 3'd0;                    // 帧外 (IDLE/SEEK) 保持 0
        else if (eop_conf_r)
            ones_cnt <= 3'd0;                    // EOP SE0 区: 恒 0, 不累计
        else if (enter_error)
            ones_cnt <= 3'd0;                    // 进 USB_ERROR 清 0 重计 (idle 探针)
        else if (d_bit) begin
            if (ones_cnt == STUFF_MAX_ONE)
                ones_cnt <= 3'd0;                // 7 连 1 (DATA 违规/ERROR 释放) → 清 0
            else
                ones_cnt <= ones_cnt + 3'd1;     // 又一个 1
        end else begin
            ones_cnt <= 3'd0;                    // bit=0 (含 stuffed 0) 清零
        end
    end

    // ---- 7 连 1 检测 (按态分义: DATA=物理错, ERROR=静默 idle 探针) ----
    // eop_conf_r 期间掩掉: EOP SE0 段不是数据, 不允许它凑出第 7 个 1 判错。
    wire seven_ones_data = (st_state == USB_DATA)  && (ones_cnt == STUFF_MAX_ONE) && d_bit && !eop_conf_r;
    wire seven_ones_err  = (st_state == USB_ERROR) && (ones_cnt == STUFF_MAX_ONE) && d_bit && !eop_conf_r;
    // 进 USB_ERROR (由 DATA 内 7 连 1 或 EOP 错触发) → ones_cnt 重计
    wire enter_error = (st_state == USB_DATA) && (eop_err_sync || seven_ones_data);

    // ---- 解填充输出 / 移位使能 ----
    // 有效数据 bit = DATA 态 + ones_cnt<6 + 非 EOP SE0 区 (stuffed 0 / 7连1 违规 /
    // EOP SE0 都不是数据, 冻结移位防 SE0 解码被当数据收进字节)。
    wire enable_shift = (st_state == USB_DATA) && (ones_cnt != STUFF_MAX_ONE) && !eop_conf_r;

    // ---- shift_reg: 7 位右移, 新数据 bit 进 MSB, 最早收到进 LSB ----
    // 第 8 位 b7 只出现在 d_bit 输入上, 由 {d_bit, shift_reg[6:0]} 拼整字节, 故 7 位即够。
    reg [6:0] shift_reg;                         // 字节移位寄存器 (存 b0~b6)
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            shift_reg <= 7'd0;
        else if (tx_active || rx_abort)
            shift_reg <= 7'd0;
        else if (st_state != USB_DATA)
            shift_reg <= 7'd0;                   // SEEK 前 / ERROR 期 / 关包后清 0
        else if (enable_shift)
            shift_reg <= {d_bit, shift_reg[6:1]};// 每有效数据 bit 移一拍
    end

    // ---- bit_cnt: 字节内位计数 (仅 DATA 有效数据位累加, 3-bit 自回绕) ----
    reg [2:0] bit_cnt;                           // 字节内位计数 0~7
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            bit_cnt <= 3'd0;
        else if (tx_active || rx_abort)
            bit_cnt <= 3'd0;
        else if (st_state != USB_DATA)
            bit_cnt <= 3'd0;
        else if (enable_shift)
            bit_cnt <= bit_cnt + 3'd1;           // 7+1 自然溢出回绕到 0
    end

    // ---- byte_rdy: 第 8 位到齐 (bit_cnt==7 且为有效数据位) ----
    wire byte_rdy = enable_shift && (bit_cnt == 3'd7);

    // ---- rx_data: 满字节拼出并锁存 (维持满字节周期) ----
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            rx_data <= 8'd0;
        else if (byte_rdy)
            rx_data <= {d_bit, shift_reg[6:0]};  // 第 8 位(b7) + 已存 b0~b6, LSb 对齐
    end

    // ---- rx_valid: byte_rdy 打一拍产生 1 拍脉冲 (数据已在脉冲拍稳定) ----
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            rx_valid <= 1'b0;
        else if (tx_active || rx_abort)
            rx_valid <= 1'b0;
        else
            rx_valid <= byte_rdy;
    end

    // ---- rx_error: 电平 (检错置起 / ERROR 保持 / 帧机回 idle 即清) ----
    // 置错仅在 DATA 态 (eop_err_sync/7连1, err_set); 帧机判进 USB_ERROR 后保持。
    // 释放判据 = 帧机已回 USB_IDLE: ERROR 由 eop_sync / 7连1 idle 探针放行回 IDLE,
    // 回 IDLE 当拍即清, 无需 was_frame/frame_just_closed 记"上一拍在帧内"的关包沿
    // (行为等价: rx_error 仍保持到第 1 个 IDLE 周期末, SIE 沿关包沿仍可读到)。
    wire err_set = (!eop_sync) && (seven_ones_data || eop_err_sync);   // 物理检错条件
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            rx_error <= 1'b0;
        else if (tx_active || rx_abort)
            rx_error <= 1'b0;                    // 中止/自发送: 立即清
        else if (err_set)
            rx_error <= 1'b1;                    // 物理检错: 置起 (电平)
        else if (st_state == USB_IDLE)
            rx_error <= 1'b0;                    // 帧机已回 idle → 释放
    end

    //========================================================================
    // ref_clk 域 — EOP/SE0 定界 (Fig.7, 独立于位流水线)
    //========================================================================

    // ---- ref_clk 域采样 line_state (每 4× 拍一次, 判 se0/j/其他) ----
    reg [1:0] line_s;                            // ref 域采样的 {rxdp,rxdn}
    always @(posedge ref_clk or negedge ref_rstn) begin
        if (!ref_rstn)
            line_s <= 2'b10;                     // 复位回 idle J
        else
            line_s <= {rxdp, rxdn};
    end
    wire line_se0 = (line_s == 2'b00);           // SE0 (D+ 与 D- 同 0)
    wire line_j   = (line_s == 2'b10);           // J (全速 idle)

    // ---- EOP FSM 寄存器 (2 段式·段1: 时序只搬 state, 仅在帧内跑) ----
    reg [2:0] eop_state;                         // EOP 定界状态 (寄存器段)
    always @(posedge ref_clk or negedge ref_rstn) begin
        if (!ref_rstn)
            eop_state <= ST_EOP_IDLE;
        else
            eop_state <= eop_nxt;                // 唯一状态更新 (组合段给次态)
    end

    // ---- EOP FSM 次态组合 (2 段式·段2) ----
    // 帧未开 (in_frame=0, 含 tx_active 强制回 IDLE) → 待命 eop_idle。
    reg [2:0] eop_nxt;                           // EOP 定界次态 (组合)
    always @* begin
        eop_nxt = eop_state;                     // 默认保持现态
        if (!in_frame)
            eop_nxt = ST_EOP_IDLE;               // 帧未开: 待命
        else begin
            case (eop_state)
                ST_EOP_IDLE: begin
                    if (line_se0)
                        eop_nxt = ST_EOP_SE0_1;  // 见 SE0 → 第 1 拍
                    else
                        eop_nxt = ST_EOP_IDLE;   // else 补全
                end
                ST_EOP_SE0_1: begin
                    if (line_se0)
                        eop_nxt = ST_EOP_SE0_2;  // 连续 SE0 → 第 2 拍
                    else
                        eop_nxt = ST_EOP_IDLE;   // <2 拍作废
                end
                ST_EOP_SE0_2: begin
                    if (line_se0)
                        eop_nxt = ST_EOP_SE0_3;  // 连续 SE0 → 第 3 拍 (EOP 确认)
                    else
                        eop_nxt = ST_EOP_IDLE;   // <3 拍作废
                end
                ST_EOP_SE0_3: begin
                    if (line_se0)
                        eop_nxt = ST_EOP_SE0_3;  // 长 SE0 自环
                    else if (line_j)
                        eop_nxt = ST_EOP_IDLE;   // 正常 EOP (SE0→J)
                    else
                        eop_nxt = ST_EOP_DEAD;   // SE0 后非 J → 异常收尾
                end
                default: // ST_EOP_DEAD
                    eop_nxt = ST_EOP_IDLE;       // 异常收尾只待一拍 (兜底含 DEAD)
            endcase
        end
    end

    // ---- EOP 事件 (ref_clk 域组合): eop / eop_err ----
    // eop_dead 见 j → 补判 eop (宽容收尾); 见非 j → eop_err (EOP 错)。
    wire eop_evt    = in_frame && (eop_state == ST_EOP_SE0_3) && line_j;   // 正常 EOP
    wire eop_evt2   = in_frame && (eop_state == ST_EOP_DEAD)  && line_j;   // 宽容收尾
    wire eop_err_evt = in_frame && (eop_state == ST_EOP_DEAD) && !line_j;  // EOP 错

    // ---- eop/eop_err 展宽 (plan B: 展到 ≥1 clk12m 周期再跨域) ----
    reg       eop_w;                             // eop 展宽电平 (ref_clk 域)
    reg       eop_err_w;                         // eop_err 展宽电平 (ref_clk 域)
    reg [3:0] widen_cnt;                         // 共享展宽计时
    wire widen_on = eop_w || eop_err_w;          // 任一展宽进行中

    always @(posedge ref_clk or negedge ref_rstn) begin
        if (!ref_rstn)
            eop_w <= 1'b0;
        else if (eop_evt || eop_evt2)
            eop_w <= 1'b1;                       // eop 事件置起
        else if (widen_on && (widen_cnt == EOP_WIDEN_MAX))
            eop_w <= 1'b0;                       // 展宽结束清除
    end

    always @(posedge ref_clk or negedge ref_rstn) begin
        if (!ref_rstn)
            eop_err_w <= 1'b0;
        else if (eop_err_evt)
            eop_err_w <= 1'b1;                   // eop_err 事件置起
        else if (widen_on && (widen_cnt == EOP_WIDEN_MAX))
            eop_err_w <= 1'b0;                   // 展宽结束清除
    end

    always @(posedge ref_clk or negedge ref_rstn) begin
        if (!ref_rstn)
            widen_cnt <= 4'd0;
        else if (widen_on) begin
            if (widen_cnt == EOP_WIDEN_MAX)
                widen_cnt <= 4'd0;               // 到顶归零 (维持展宽电平)
            else
                widen_cnt <= widen_cnt + 4'd1;   // 展宽计时
        end else begin
            widen_cnt <= 4'd0;                   // 空闲归零 (else 补全)
        end
    end

    // ---- 跨到 clk12m 域 (边沿对齐, 单拍采样, 无亚稳态) ----
    // 两时钟由 ref_clk 派生、上升沿对齐, eop_w 展宽 ≥1 clk12m 故不漏检 (报告 §2.7)。
    reg eop_sync;                                // eop 跨域到 clk12m (1 拍采样)
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            eop_sync <= 1'b0;
        else
            eop_sync <= eop_w;
    end

    reg eop_err_sync;                            // eop_err 跨域到 clk12m (1 拍采样)
    always @(posedge clk12m or negedge ref_rstn) begin
        if (!ref_rstn)
            eop_err_sync <= 1'b0;
        else
            eop_err_sync <= eop_err_w;
    end

    // ---- (EOP 假 7 连 1 修复核心) EOP 已确认门控 → clk12m 域 ----
    // EOP 确认 = eop_state 达 se0_3 (SE0≥3 采样≈62.5ns, 判决点之后) 或进入 dead
    // (SE0 后异常收尾); 用 ref_clk 打一拍得 eop_conf_r, 供 clk12m 位流水线读。
    // ref/clk12m 为派生同步时钟、上升沿对齐, ref 域寄存信号对 clk12m 稳定。
    wire eop_conf = (eop_state == ST_EOP_SE0_3) || (eop_state == ST_EOP_DEAD);  // EOP 已确认
    reg eop_conf_r;                              // eop_conf 打一拍 (ref_clk)
    always @(posedge ref_clk or negedge ref_rstn) begin
        if (!ref_rstn)
            eop_conf_r <= 1'b0;
        else
            eop_conf_r <= eop_conf;
    end

endmodule
