digraph FSM {
  graph [labelloc="t", labeljust="c", fontname="Helvetica", fontsize=13];
  label="DPLL 时钟恢复状态机（USB 1.1, 48MHz, Intel SIE 结构）";
  rankdir=TB;
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, fillcolor="#EEF2F7", color="#444444", penwidth=1.2, margin="0.15,0.06"];
  edge [fontname="Helvetica", fontsize=10, color="#555555", arrowsize=0.8];
  "C" [fillcolor="#FFF2CC", label="C", peripheries="2"];
  "D" [fillcolor="#FFF2CC", label="D"];
  "1" [fillcolor="#DDEBF7", label="1"];
  "0" [fillcolor="#DDEBF7", label="0"];
  "3" [fillcolor="#C6EFCE", label="3"];
  "2" [fillcolor="#C6EFCE", label="2"];
  "5" [fillcolor="#DDEBF7", label="5"];
  "4" [fillcolor="#DDEBF7", label="4"];
  "7" [fillcolor="#C6EFCE", label="7"];
  "6" [fillcolor="#C6EFCE", label="6"];
  "F" [fillcolor="#FCE4D6", label="F"];
  "B" [fillcolor="#FCE4D6", label="B"];
  { rank=same; "C"; "D"; }
  { rank=same; "1"; "5"; }
  { rank=same; "3"; "7"; }
  { rank=same; "2"; "6"; "F"; "B"; }
  { rank=same; "0"; "4"; }
  "C" -> "C" [label="b≠0", constraint="false"];
  "C" -> "D" [label="b=0"];
  "D" -> "D" [label="b=0", constraint="false"];
  "D" -> "5" [label="b=1"];
  "1" -> "3";
  "3" -> "2" [label="a=0"];
  "2" -> "0" [label="b=0"];
  "5" -> "7";
  "7" -> "6" [label="a=1"];
  "6" -> "4" [label="b=1"];
  "3" -> "F" [label="a=1", constraint="false"];
  "F" -> "6" [constraint="true"];
  "7" -> "B" [label="a=0", constraint="true"];
  "B" -> "2" [constraint="false"];
  "2" -> "5" [label="b=1", constraint="false"];
  "0" -> "5" [label="b=1", constraint="false"];
  "6" -> "1" [label="b=0", constraint="false"];
  "4" -> "1" [label="b=0", constraint="false"];
  "0" -> "1" [label="b=0", constraint="false"];
  "4" -> "5" [label="b=1", constraint="false"];
}
